{
  "name": "vivac",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "build:web": "turbo run build --filter=@vivac/web",
    "dev:web": "turbo run dev --filter=@vivac/web",
    "since:build": "yarn workspaces foreach --since --topological-dev --parallel --verbose run build",
    "since:lint": "yarn workspaces foreach --since --topological-dev --parallel --verbose run lint",
    "since:typecheck": "yarn workspaces foreach --since --topological-dev --parallel --verbose run typecheck",
    "ws:list": "yarn workspaces list"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "turbo": "^2.9.9",
    "typescript": "^5.8.3"
  }
}
